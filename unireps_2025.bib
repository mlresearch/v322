@inproceedings{
fumero25,
title={Preface of UniReps: the Third Edition of the Workshop on Unifying Representations in Neural Models},
author={Fumero, Marco and Cannistraci, Irene and Domine, Clementine and Zhao, Bo and Williams, Alex and L{"a}hner, Zorah},
